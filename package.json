{
  "name": "dev-buddy",
  "displayName": "DevBuddy",
  "description": "Herramientas de productividad para DevOps en VS Code: YAML para .helm y gestion de comandos personalizados.",
  "version": "0.0.3",
  "license": "UNLICENSED",
  "publisher": "local-dev",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "myCommandExtension.openDashboard",
        "title": "DevBuddy: Abrir panel visual"
      },
      {
        "command": "myCommandExtension.createHelmYaml",
        "title": "DevBuddy: Crear Environment File en .helm"
      },
      {
        "command": "myCommandExtension.runCustomCommand",
        "title": "DevBuddy: Ejecutar comando personalizado"
      },
      {
        "command": "myCommandExtension.createCustomCommand",
        "title": "DevBuddy: Crear comando personalizado"
      },
      {
        "command": "myCommandExtension.listCustomCommands",
        "title": "DevBuddy: Ver lista de comandos personalizados"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "myCommandExtension.createHelmYaml",
          "when": "explorerResourceIsFolder && resourceFilename == '.helm'",
          "group": "navigation@10"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devBuddy",
          "title": "DevBuddy",
          "icon": "media/devbuddy.svg"
        }
      ]
    },
    "views": {
      "devBuddy": [
        {
          "id": "devBuddySidebarView",
          "name": "Panel",
          "icon": "media/devbuddy.svg",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "DevBuddy",
      "properties": {
        "myCommandExtension.customCommands": {
          "type": "array",
          "default": [
            {
              "name": "Listar archivos",
              "command": "Get-ChildItem"
            }
          ],
          "description": "Lista de comandos personalizados para ejecutar desde la extension.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Nombre visible del comando."
              },
              "command": {
                "type": "string",
                "description": "Comando de terminal a ejecutar."
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package:vsix": "tsc -p ./ && npx @vscode/vsce package --allow-missing-repository",
    "release:patch": "npm version patch -m \"chore(release): v%s\" && git push origin main --follow-tags",
    "release:minor": "npm version minor -m \"chore(release): v%s\" && git push origin main --follow-tags",
    "release:major": "npm version major -m \"chore(release): v%s\" && git push origin main --follow-tags"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.2"
  }
}
